/// Virtual helper table with no data rows. Used exclusively to host all 56 DAX measures, the 5 reusable UDFs (PeriodComparisonPct, ComparisonColor, YearOverYearPercent, FormatCurrencyAmount, FormatCount), and the dashboard title and label measures. Centralising all measures here keeps the model organised and prevents them from being scattered across fact and dimension tables.
table KPIs
	lineageTag: 556a4cbd-83f6-4f80-a567-53579a8880c0

	/// Total Databricks cost in USD for the selected period.
	measure 'Total Cost (USD)' = SUM ( Costs[Cost (USD)] )
		displayFolder: Cost\Base
		lineageTag: 89a0b4d7-76dd-46fd-aefc-be99c914aa22

		formatStringDefinition = FormatCurrencyValue ( SELECTEDMEASURE (), 1 )

	/// Total cost for the same period last year.
	measure 'Total Cost (USD) (ly)' = CALCULATE ( [Total Cost (USD)], SAMEPERIODLASTYEAR ( Calendar[Date] ) )
		displayFolder: Cost\Time Intelligence
		lineageTag: 19c1b526-84bc-42fb-8866-3a4069488fd8

		formatStringDefinition = FormatCurrencyValue ( SELECTEDMEASURE (), 1 )

	/// Year-to-date cumulative cost.
	measure 'Total Cost (USD) (ytd)' = TOTALYTD ( [Total Cost (USD)], Calendar[Date] )
		formatString: $#,##0.00
		displayFolder: Cost\Time Intelligence
		lineageTag: d1701ddc-9632-4e52-9047-8c6131bb3a2a

	/// Month-to-date cumulative cost.
	measure 'Total Cost (USD) (mtd)' = TOTALMTD ( [Total Cost (USD)], Calendar[Date] )
		formatString: $#,##0.00
		displayFolder: Cost\Time Intelligence
		lineageTag: 5f116b77-e372-4178-ab6e-66a979fa821a

	/// Year-over-year cost growth rate.
	measure 'Cost (USD) YoY (%)' = DIVIDE ( [Total Cost (USD)] - [Total Cost (USD) (ly)], [Total Cost (USD) (ly)] )
		formatString: 0.0%
		displayFolder: Cost\Time Intelligence
		lineageTag: e7c46b94-6611-41c1-9248-e47bc547e6d1

	/// Average cost per day with recorded usage.
	measure 'Avg Daily Cost (USD)' = DIVIDE ( [Total Cost (USD)], [Days with Cost] )
		formatString: $#,##0.00
		displayFolder: Cost\Base
		lineageTag: a8130fa2-d212-4865-baac-e6695a703321

	/// Total usage quantity across all SKUs and usage types.
	measure 'Total Usage Quantity' = SUM ( Costs[Usage Quantity] )
		formatString: #,##0.00
		displayFolder: Volume
		lineageTag: ab91f179-d5d1-4c53-8f27-5b2ac339c3f9

	/// Average cost per unit of usage — efficiency indicator across SKUs.
	measure 'Avg Cost per Unit (USD)' = DIVIDE ( [Total Cost (USD)], [Total Usage Quantity] )
		formatString: $#,##0.000
		displayFolder: Volume
		lineageTag: d6443332-71ce-4544-98fa-d9d264a7edce

	/// Number of distinct workspaces with recorded costs in the selected period.
	measure '# Active Workspaces' = DISTINCTCOUNT ( Costs[Workspace Key] )
		formatString: #,0
		displayFolder: Attribution
		lineageTag: 516e9bc9-26f4-48a8-904b-5857aaba09fa

	/// Number of distinct users or service principals generating costs in the selected period.
	measure '# Active Identities' = DISTINCTCOUNT ( Costs[Identity Key] )
		formatString: #,0
		displayFolder: Attribution
		lineageTag: aab6df95-01fc-4c72-af9d-20a542a49f56

	/// Number of distinct resources (jobs, clusters, warehouses) with recorded costs in the selected period.
	measure '# Active Resources' = DISTINCTCOUNT ( Costs[Resource Key] )
		formatString: #,0
		displayFolder: Attribution
		lineageTag: 54a767c1-0577-4bd3-9206-0db69b70f277

	/// Average cost per active workspace in the selected period.
	measure 'Cost per Workspace (USD)' = DIVIDE ( [Total Cost (USD)], [# Active Workspaces] )
		formatString: $#,##0.00
		displayFolder: Attribution
		lineageTag: 8919dc5f-e8cb-4684-84f7-298216c723c4

	/// Average cost per active user or service principal in the selected period.
	measure 'Cost per Identity (USD)' = DIVIDE ( [Total Cost (USD)], [# Active Identities] )
		formatString: $#,##0.00
		displayFolder: Attribution
		lineageTag: 56b7c031-12ac-4923-8f9d-05596a3b4e20

	/// Total cost attributed to serverless compute.
	measure 'Serverless Cost (USD)' = CALCULATE ( [Total Cost (USD)], Costs[Is Serverless] = 1 )
		formatString: $#,##0.00
		displayFolder: Product Mix
		lineageTag: 5ab5b6a9-42dc-436d-bc42-02c5e04dd244

	/// Serverless compute share of total cost.
	measure 'Serverless Cost (%)' = DIVIDE ( [Serverless Cost (USD)], [Total Cost (USD)] )
		formatString: 0.0%
		displayFolder: Product Mix
		lineageTag: c97b08f4-82a4-4a0b-907f-12c58a9b8b8a

	/// Total cost attributed to Photon-accelerated compute.
	measure 'Photon Cost (USD)' = CALCULATE ( [Total Cost (USD)], Costs[Is Photon] = 1 )
		formatString: $#,##0.00
		displayFolder: Product Mix
		lineageTag: 690b2809-b78c-476a-ae6b-0dea3b9b4ded

	/// Photon compute share of total cost.
	measure 'Photon Cost (%)' = DIVIDE ( [Photon Cost (USD)], [Total Cost (USD)] )
		formatString: 0.0%
		displayFolder: Product Mix
		lineageTag: 235a9920-7d68-496e-a9ea-d953d12321c9

	/// Absolute cost change versus the previous calendar month.
	measure 'Cost vs Prior Month (USD)' =
			VAR _PriorMonth =
			    CALCULATE ( [Total Cost (USD)], PREVIOUSMONTH ( Calendar[Date] ) )
			RETURN
			    [Total Cost (USD)] - _PriorMonth
		formatString: $#,##0.00
		displayFolder: Trend
		lineageTag: f36157f4-d784-469c-9bdc-fffa856dc8e3

	/// Percentage cost change versus the previous calendar month.
	measure 'Cost vs Prior Month (%)' =
			VAR _PriorMonth =
			    CALCULATE ( [Total Cost (USD)], PREVIOUSMONTH ( Calendar[Date] ) )
			RETURN
			    DIVIDE ( [Total Cost (USD)] - _PriorMonth, _PriorMonth )
		formatString: 0.0%
		displayFolder: Trend
		lineageTag: a4ce0204-5582-4ae4-a7c3-fd444b5a7a37

	/// Highest cost recorded on a single day — used for spike detection.
	measure 'Peak Daily Cost (USD)' = MAXX ( VALUES ( Calendar[Date] ), [Total Cost (USD)] )
		formatString: $#,##0.00
		displayFolder: Trend
		lineageTag: 809438d2-d440-47da-925d-dca4a9f0b35b

	/// Number of distinct days with recorded Databricks usage in the selected period.
	measure 'Days with Cost' = DISTINCTCOUNT ( Costs[Usage Date] )
		formatString: #,0
		displayFolder: Trend
		lineageTag: 2ce7f6ea-6fc7-4591-a955-3a8a1c9db17f

	/// Dense rank of each workspace by total cost in descending order. Use as a visual-level filter (≤ 10) to display only the top 10 highest-spending workspaces.
	measure 'Workspace Rank (by Cost)' = RANKX ( ALL ( 'Workspace'[Workspace Name] ), [Total Cost (USD)],, DESC, DENSE )
		formatString: #,0
		displayFolder: Cost\Rankings
		lineageTag: 4d6ffb87-c721-4792-bca0-8c36a4ecb429

	/// Total cost restricted to the 10 highest-spending workspaces. Returns BLANK for all other workspaces, making it safe to drop directly onto a bar chart without adding a visual-level filter.
	measure 'Top 10 Workspace Cost (USD)' =
			IF (
			    RANKX ( ALL ( 'Workspace'[Workspace Name] ), [Total Cost (USD)],, DESC, DENSE ) <= 10,
			    [Total Cost (USD)]
			)
		formatString: $#,##0.00
		displayFolder: Cost\Rankings
		lineageTag: b022e27a-7fd3-4ce5-9c2f-e941d5388bcf

	/// Dense rank of each JOB-type resource by total cost in descending order. Use as a visual-level filter (≤ 10) to display only the top 10 highest-spending jobs.
	measure 'Job Rank (by Cost)' =
			RANKX (
			    CALCULATETABLE (
			        ALL ( Resource[Resource Name] ),
			        Resource[Resource Type] = "JOB"
			    ),
			    CALCULATE ( [Total Cost (USD)], Resource[Resource Type] = "JOB" ),
			    ,
			    DESC,
			    DENSE
			)
		formatString: #,0
		displayFolder: Cost\Rankings
		lineageTag: dd50379d-756d-4669-9a74-8a2dfdb43068

	/// Total cost restricted to the 10 highest-spending JOB-type resources. Returns BLANK for non-JOB resources and jobs outside the top 10.
	measure 'Top 10 Job Cost (USD)' =
			VAR _rank =
			    RANKX (
			        CALCULATETABLE (
			            ALL ( Resource[Resource Name] ),
			            Resource[Resource Type] = "JOB"
			        ),
			        CALCULATE ( [Total Cost (USD)], Resource[Resource Type] = "JOB" ),
			        ,
			        DESC,
			        DENSE
			    )
			RETURN
			    IF (
			        SELECTEDVALUE ( Resource[Resource Type] ) = "JOB" && _rank <= 10,
			        [Total Cost (USD)]
			    )
		formatString: $#,##0.00
		displayFolder: Cost\Rankings
		lineageTag: 8c1a7009-a215-4dce-8ac2-d74dadf35e9c

	/// Title showing the latest ingestion date across the Costs table, unfiltered. Calls LatestDataLabel with Format defaulting to \"Date\".
	measure 'Latest Data Date' = LatestDataLabel ( "Data", 'Costs'[Ingestion Date] )
		displayFolder: _Titles
		lineageTag: c1a94580-7df6-49de-906a-4be288f31ceb

	/// Returns 1 when the Costs table is not empty in the current filter context (i.e. at least one slicer selection is active), 0 otherwise. Used to conditionally show or hide visuals depending on whether a filter is applied.
	measure 'Is Slicer Filtered' = INT ( NOT ISEMPTY ( 'Costs' ) )
		isHidden
		displayFolder: _Internal
		lineageTag: a4a5f318-134e-458f-8969-c25a2352da32

	/// Total cost restricted to the 10 highest-spending resources across all types. Returns BLANK for resources outside the top 10. Use on Page 3 Resource Detail ranking bar.
	measure 'Top 10 Resource Cost (USD)' =
			IF (
			    RANKX ( ALL ( Resource[Resource Name] ), [Total Cost (USD)],, DESC, DENSE ) <= 10,
			    [Total Cost (USD)]
			)
		formatString: $#,##0.00
		displayFolder: Cost\Rankings
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567890

	/// Share of total cost for each resource row. Used as a detail table column on the Resource Detail page.
	measure 'Cost % of Total (Resource)' =
			DIVIDE (
			    [Total Cost (USD)],
			    CALCULATE ( [Total Cost (USD)], ALL ( Resource ) )
			)
		formatString: 0.0%
		displayFolder: Cost\Rankings
		lineageTag: b2c3d4e5-f6a7-8901-bcde-f01234567891

	/// Two-line header label showing the model refresh timestamp from RefreshDate with a refresh icon. Used on the report header card.
	measure 'Last Refreshed' =
			VAR _Date =
			    FORMAT (
			        SELECTEDVALUE ( RefreshDate[Last refreshed] ),
			        "MMM DD yyyy hh:nn AM/PM",
			        USERCULTURE ()
			    )
			RETURN
			    "Last refreshed " & UNICHAR ( 10 ) & UNICHAR ( 128260 ) & " " & _Date & " UTC"
		displayFolder: _Titles
		lineageTag: 570aec69-604c-4414-a074-871f16417e24

	/// Percentage change of Total Cost (USD) versus the prior period selected in the TimeCalculationPriorPeriod calculation group. Calls the PeriodComparisonPercentage UDF.
	measure 'Total Cost (USD) Comparaison' = PeriodComparisonPercentage ( [Total Cost (USD)] )
		displayFolder: Comparaison
		lineageTag: 626a76b6-cc20-42b7-8362-3ce535f69790

		formatStringDefinition = PercentageFormat()

	/// Conditional-formatting color (good/bad) for the Total Cost comparison KPI, derived from the sign of the comparison. Calls the PeriodComparisonColor UDF.
	measure 'Total Cost (USD) Comparaison Color' = PeriodComparisonColor ( [Total Cost (USD) Comparaison] )
		displayFolder: Comparaison
		lineageTag: 4af88301-9c8d-4f33-9ff4-04eae60e5692

	/// Total warehouse cost attributed to SQL statement executions for the selected period.
	measure 'Total Query Cost (USD)' = SUM ( 'QueryCosts'[Attributed Cost (USD)] )
		displayFolder: Query Cost\Base
		lineageTag: 5f80de89-63e9-4205-83b9-585ed848b79a

		formatStringDefinition = FormatCurrencyValue ( SELECTEDMEASURE (), 1 )

	/// Number of SQL statement executions in the selected period.
	measure '# Statements' = COUNTROWS ( 'QueryCosts' )
		formatString: #,0
		displayFolder: Query Cost\Base
		lineageTag: d90f6217-06fe-42ce-a86d-f70d749345ed

	/// Average attributed cost per statement execution - unit-cost indicator for expensive-query drift.
	measure 'Avg Cost per Statement (USD)' = DIVIDE ( [Total Query Cost (USD)], [# Statements] )
		formatString: $#,##0.0000
		displayFolder: Query Cost\Base
		lineageTag: 395f1ddf-1982-4cb5-8ae3-975a386bff69

	/// Share of total Databricks cost attributable to SQL warehouse statement executions.
	measure 'Query Cost Share (%)' = DIVIDE ( [Total Query Cost (USD)], [Total Cost (USD)] )
		formatString: 0.0%
		displayFolder: Query Cost\Base
		lineageTag: 49defb77-ef8a-43aa-81e7-85e2fa9acc37

	/// Average end-to-end statement duration in seconds.
	measure 'Avg Query Duration (s)' = DIVIDE ( AVERAGE ( 'QueryCosts'[Total Duration (ms)] ), 1000 )
		formatString: #,##0.0
		displayFolder: Query Cost\Performance
		lineageTag: b402cd3f-7a51-4f4e-b2f0-d4be4181a4f9

	/// 90th percentile of statement duration in seconds - tail-latency indicator.
	measure 'P90 Query Duration (s)' = DIVIDE ( PERCENTILEX.INC ( 'QueryCosts', 'QueryCosts'[Total Duration (ms)], 0.9 ), 1000 )
		formatString: #,##0.0
		displayFolder: Query Cost\Performance
		lineageTag: 495fb305-b88e-4c6a-ae80-735f53c70dd7

	/// Share of total statement time spent queued (warehouse at capacity) or waiting for compute to provision. High values indicate an undersized warehouse.
	measure 'Queue Time Share (%)' = VAR _Wait = SUM ( 'QueryCosts'[Waiting at Capacity (ms)] ) + SUM ( 'QueryCosts'[Waiting for Compute (ms)] ) RETURN DIVIDE ( _Wait, SUM ( 'QueryCosts'[Total Duration (ms)] ) )
		formatString: 0.0%
		displayFolder: Query Cost\Performance
		lineageTag: 082d63ec-d100-424d-bdab-8aa1b98c06f4

	/// Number of statements running longer than 5 minutes in the selected period.
	measure '# Long-Running Statements' = CALCULATE ( [# Statements], 'QueryCosts'[Total Duration (ms)] > 300000 )
		formatString: #,0
		displayFolder: Query Cost\Performance
		lineageTag: 07a49950-d340-44e6-9673-cd66a70d01cf

	/// Share of statements served from the result cache (no warehouse compute consumed). Higher is better.
	measure 'Cache Hit Rate (%)' = DIVIDE ( CALCULATE ( [# Statements], 'QueryCosts'[From Result Cache] = "Yes" ), [# Statements] )
		formatString: 0.0%
		displayFolder: Query Cost\Efficiency
		lineageTag: 019dc3cc-163f-4b5e-9e21-ec24670f301c

	/// Share of statements that ended in FAILED status.
	measure 'Failed Statement Rate (%)' = DIVIDE ( CALCULATE ( [# Statements], 'QueryCosts'[Execution Status] = "FAILED" ), [# Statements] )
		formatString: 0.0%
		displayFolder: Query Cost\Efficiency
		lineageTag: 4e54168b-6a05-45bb-9554-b2debe4d7323

	/// Warehouse cost attributed to statements that failed - compute spend that produced no result.
	measure 'Failed Statements Cost (USD)' = CALCULATE ( [Total Query Cost (USD)], 'QueryCosts'[Execution Status] = "FAILED" )
		formatString: $#,##0.00
		displayFolder: Query Cost\Efficiency
		lineageTag: 959384f9-1f7e-4b32-bc17-31d5709051b6

	/// Total data volume read by statements, in gigabytes.
	measure 'Total Read (GB)' = SUM ( 'QueryCosts'[Read (GB)] )
		formatString: #,##0.0
		displayFolder: Query Cost\Efficiency
		lineageTag: da7c0e97-a577-431e-a4a4-bab237b3c01b

	/// Attributed cost per gigabyte scanned - scan-efficiency indicator; rising values suggest missing pruning or clustering.
	measure 'Cost per GB Read (USD)' = DIVIDE ( [Total Query Cost (USD)], [Total Read (GB)] )
		formatString: $#,##0.000
		displayFolder: Query Cost\Efficiency
		lineageTag: 45f486e8-b4ea-4fb5-b728-03e00a7245ed

	/// Number of distinct identities that executed statements in the selected period (sentinel identities excluded).
	measure '# Query Users' = CALCULATE ( DISTINCTCOUNT ( 'QueryCosts'[Identity Key] ), 'QueryCosts'[Identity Key] > 0 )
		formatString: #,0
		displayFolder: Query Cost\Rankings
		lineageTag: 337d54cd-ef69-4f41-80f8-826c312d298f

	/// Average attributed query cost per active query user.
	measure 'Cost per Query User (USD)' = DIVIDE ( [Total Query Cost (USD)], [# Query Users] )
		formatString: $#,##0.00
		displayFolder: Query Cost\Rankings
		lineageTag: a19b9716-b882-416e-8924-199ed1e5e9d7

	/// Query cost restricted to the 10 highest-spending identities. Returns BLANK outside the top 10 - safe to drop directly onto a bar chart.
	measure 'Top 10 User Query Cost (USD)' = IF ( RANKX ( ALL ( Identity[Identity Name] ), [Total Query Cost (USD)],, DESC, DENSE ) <= 10, [Total Query Cost (USD)] )
		formatString: $#,##0.00
		displayFolder: Query Cost\Rankings
		lineageTag: 9bb102f2-c9f7-4c8b-8542-4f0c65dae18f

	/// Query cost restricted to the 10 highest-cost SQL warehouses. Returns BLANK outside the top 10.
	measure 'Top 10 Warehouse Query Cost (USD)' = IF ( RANKX ( ALL ( Resource[Resource Name] ), [Total Query Cost (USD)],, DESC, DENSE ) <= 10, [Total Query Cost (USD)] )
		formatString: $#,##0.00
		displayFolder: Query Cost\Rankings
		lineageTag: 1a7438ce-0904-4cb3-9235-b2f68df34baa

	/// Percentage change of Total Query Cost versus the prior period selected in the TimeCalculationPriorPeriod calculation group. Calls the PeriodComparisonPercentage UDF.
	measure 'Total Query Cost (USD) Comparaison' = PeriodComparisonPercentage ( [Total Query Cost (USD)] )
		displayFolder: Comparaison
		lineageTag: 3e3014d2-6766-4394-9b73-b227f5b3d7f0

		formatStringDefinition = PercentageFormat()

	/// Conditional-formatting color (good/bad) for the Total Query Cost comparison KPI. Calls the PeriodComparisonColor UDF.
	measure 'Total Query Cost (USD) Comparaison Color' = PeriodComparisonColor ( [Total Query Cost (USD) Comparaison] )
		displayFolder: Comparaison
		lineageTag: 341f4743-26fd-41ed-a82e-27bb6a43fd6f

	measure Measure = sum(QueryCosts[Warehouse Cost (USD)])
		displayFolder: Query Cost\Base
		lineageTag: b045bf2c-b4a5-4a21-b78c-d98cedce855f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Query Cost (USD) (ly)' = CALCULATE ( [Total Query Cost (USD)], SAMEPERIODLASTYEAR ( Calendar[Date] ) )
		displayFolder: Cost\Time Intelligence
		lineageTag: f0d796da-b45c-412d-87fa-71c4d7e89756

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total usage quantity across all SKUs and usage types.
	measure 'Total Usage (DBUs)' = CALCULATE ( [Total Usage Quantity], 'Costs'[Usage Unit] = "DBU" )
		displayFolder: Volume
		lineageTag: 72ada6bc-a1af-4c90-83f8-3f40dcf1bc09

		formatStringDefinition = FormatValue ( SELECTEDMEASURE ())

	/// Total cost for the same period last year.
	measure 'Total Usage (DBUs) (ly)' = CALCULATE ( [Total Usage (DBUs)], SAMEPERIODLASTYEAR ( Calendar[Date] ) )
		displayFolder: Volume\Time Intelligence
		lineageTag: 52fb4c9e-1220-4b4a-9a95-92c4cd9bc9f0

		formatStringDefinition = FormatValue ( SELECTEDMEASURE () )

	/// Percentage change of Total Cost (USD) versus the prior period selected in the TimeCalculationPriorPeriod calculation group. Calls the PeriodComparisonPercentage UDF.
	measure 'Total Usage (DBUs) Comparaison' = PeriodComparisonPercentage ( [Total Usage (DBUs)] )
		displayFolder: Comparaison
		lineageTag: b2278841-fd72-4ae7-b901-003a65c415df

		formatStringDefinition = PercentageFormat()

	/// Conditional-formatting color (good/bad) for the Total Cost comparison KPI, derived from the sign of the comparison. Calls the PeriodComparisonColor UDF.
	measure 'Total Usage (DBUs) Comparaison Color' = PeriodComparisonColor ( [Total Usage (DBUs) Comparaison] )
		displayFolder: Comparaison
		lineageTag: c91fe496-6a61-4f95-8672-a4c6581b0fdb

	measure 'Title Cost Usage by Dimension Fields' =
			VAR _cost_usage =
			    SELECTEDVALUE ('CostOrUsage'[Short Name] )
			VAR _dimension =
			    SELECTEDVALUE ('Filters'[Filters Title]  )
			RETURN
			    _cost_usage & " by " & _dimension
		displayFolder: _Titles
		lineageTag: 85a3ae94-9594-42b7-8b4a-8ea431e0bcd8

	measure 'SubTitle Cost Usage by Dimension Fields' =
			VAR _cost_usage =
			    SELECTEDVALUE ('CostOrUsage'[Title] )
			VAR _dimension =
			    SELECTEDVALUE ('Filters'[Filters Title]  )
			RETURN
			    _cost_usage & " by " & _dimension
		displayFolder: _Titles
		lineageTag: d1ab5e76-a714-476f-8203-d8e365809af5

	measure 'SubTitle Cost Usage Trend' =
			VAR _cost_usage =
			    SELECTEDVALUE ( 'CostOrUsage'[Title] )
			RETURN
			    _cost_usage & " by Date"
		displayFolder: _Titles
		lineageTag: 7379a20a-425f-4029-9a14-ad86628e80c5

	measure 'Title Cost Usage Trend' =
			VAR _cost_usage =
			    SELECTEDVALUE ( 'CostOrUsage'[Short Name] )
			RETURN
			    "Daily " & _cost_usage & " Trend"
		displayFolder: _Titles
		lineageTag: 70e50b7c-9832-4e73-9788-f1726fc5a235

	/// Share of total cost for each resource row. Used as a detail table column on the Resource Detail page.
	measure '% of Total (Resource)' =
			VAR _numerator =
			    IF (
			        SELECTEDVALUE ( 'CostOrUsage'[Short Name] ) = "Cost",
			        [Total Cost (USD)],
			        [Total Usage (DBUs)]
			    )
			VAR _denominator =
			    IF (
			        SELECTEDVALUE ( 'CostOrUsage'[Short Name] ) = "Cost",
			        CALCULATE ( [Total Cost (USD)], ALL ( Resource ) ),
			        CALCULATE ( [Total Usage (DBUs)], ALL ( Resource ) )
			    )
			RETURN
			    DIVIDE ( _numerator, _denominator )
		formatString: 0.0%
		displayFolder: Cost\Rankings
		lineageTag: 8ca9d751-2289-4d11-8931-9d1284f29d0a

	/// Share of total cost for each resource row. Used as a detail table column on the Resource Detail page.
	measure '% of Total' =
			VAR _isCost =
			    SELECTEDVALUE ( 'CostOrUsage'[Short Name] ) = "Cost"
			VAR _numerator =
			    IF ( _isCost, [Total Cost (USD)], [Total Usage (DBUs)] )
			VAR _denominator =
			    IF (
			        _isCost,
			        CALCULATE ( [Total Cost (USD)], ALLSELECTED () ),
			        CALCULATE ( [Total Usage (DBUs)], ALLSELECTED () )
			    )
			RETURN
			    DIVIDE ( _numerator, _denominator )
		formatString: 0.0%
		displayFolder: Cost\Rankings
		lineageTag: ba603fdb-2ce7-4b3a-89f3-b8d34a3243ef

	/// Returns Total Query Cost (USD) only for the top 10 categories of whichever field is selected in the 'Filters' field parameter. Uses ISINSCOPE to detect the axis field (Identity Type, Resource Type, Workspace Name, Identity Name, or Client Application), so it survives reordering the parameter. Blank outside the top 10. Use as the visual value, or as an 'is not blank' visual-level filter while keeping Total Query Cost (USD) as the bar value.
	measure 'Top 10 Query Cost (USD)' =
			VAR _cost =
			    [Total Query Cost (USD)]
			VAR _rank =
			    SWITCH (
			        TRUE (),
			        ISINSCOPE ( 'Identity'[Identity Type] ), RANKX ( ALLSELECTED ( 'Identity'[Identity Type] ), [Total Query Cost (USD)], , DESC ),
			        ISINSCOPE ( 'Resource'[Resource Type] ), RANKX ( ALLSELECTED ( 'Resource'[Resource Type] ), [Total Query Cost (USD)], , DESC ),
			        ISINSCOPE ( 'Workspace'[Workspace Name] ), RANKX ( ALLSELECTED ( 'Workspace'[Workspace Name] ), [Total Query Cost (USD)], , DESC ),
			        ISINSCOPE ( 'Identity'[Identity Name] ), RANKX ( ALLSELECTED ( 'Identity'[Identity Name] ), [Total Query Cost (USD)], , DESC ),
			        ISINSCOPE ( 'QueryCosts'[Client Application] ), RANKX ( ALLSELECTED ( 'QueryCosts'[Client Application] ), [Total Query Cost (USD)], , DESC )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _rank ) && _rank <= 10, _cost )
		formatString: "$"#,##0.00
		displayFolder: Query Cost\Rankings
		lineageTag: c59e8f32-ad80-4f5f-a7bc-667cc3fab769

	/// Returns Avg Query Duration (s) only for the top 10 categories (by highest average duration) of whichever field is selected in the 'Filters' field parameter. Uses ISINSCOPE to detect the axis field (Identity Type, Resource Type, Workspace Name, Identity Name, or Client Application), so it survives reordering the parameter. Blank outside the top 10. Use as the visual value, or as an 'is not blank' visual-level filter while keeping Avg Query Duration (s) as the bar value.
	measure 'Top 10 Avg Query Duration (s)' =
			VAR _value =
			    [Avg Query Duration (s)]
			VAR _rank =
			    SWITCH (
			        TRUE (),
			        ISINSCOPE ( 'Identity'[Identity Type] ), RANKX ( ALLSELECTED ( 'Identity'[Identity Type] ), [Avg Query Duration (s)], , DESC ),
			        ISINSCOPE ( 'Resource'[Resource Type] ), RANKX ( ALLSELECTED ( 'Resource'[Resource Type] ), [Avg Query Duration (s)], , DESC ),
			        ISINSCOPE ( 'Workspace'[Workspace Name] ), RANKX ( ALLSELECTED ( 'Workspace'[Workspace Name] ), [Avg Query Duration (s)], , DESC ),
			        ISINSCOPE ( 'Identity'[Identity Name] ), RANKX ( ALLSELECTED ( 'Identity'[Identity Name] ), [Avg Query Duration (s)], , DESC ),
			        ISINSCOPE ( 'QueryCosts'[Client Application] ), RANKX ( ALLSELECTED ( 'QueryCosts'[Client Application] ), [Avg Query Duration (s)], , DESC )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _rank ) && _rank <= 10, _value )
		formatString: #,##0.0
		displayFolder: Query Cost\Rankings
		lineageTag: 3fbb5967-8d68-49c6-b42f-19821bab2c1f

	measure 'Title Top 10 by Cost' =
			VAR _dimension =
			    SELECTEDVALUE ( 'Filters'[Filters Title] )
			RETURN
			    "Top 10 " & _dimension & " by Cost"
		displayFolder: _Titles
		lineageTag: f332e5da-3e9f-4a91-ad88-3fb6024372ad

	measure 'Title Top 10 by Query Duration (s)' =
			VAR _dimension =
			    SELECTEDVALUE ( 'Filters'[Filters Title] )
			RETURN
			    "Top 10 " & _dimension & " by Query Duration (s)"
		displayFolder: _Titles
		lineageTag: 6d3f8da3-ab39-443d-8598-32bea741736e

	/// Returns 1 when the Query Costs table is not empty in the current filter context (i.e. at least one slicer selection is active), 0 otherwise. Used to conditionally show or hide visuals depending on whether a filter is applied.
	measure 'Is Slicer Filtered Query Costs' = INT ( NOT ISEMPTY ( 'QueryCosts' ) )
		isHidden
		displayFolder: _Internal
		lineageTag: 4493925c-124a-4a78-a631-b562dfb8250c

	/// Total Cost (USD), formatted for display via a dynamic format string: scaled/currency-formatted like Total Cost (USD) (K/M, $) with its share of total appended, e.g. "$222.9K (23.4% of total)". Numeric measure (not text) — usable in any visual, sortable, aggregatable; combines Total Cost (USD) and % of Total (Identity) via FormatCurrencyValue.
	measure 'Total Cost (USD) Formatted' = [Total Cost (USD)]
		displayFolder: Cost\Base
		lineageTag: 49e86b0b-afcf-4268-adbb-dcb9657d2440

		formatStringDefinition =
				VAR _Q = UNICHAR ( 34 )
				VAR _PctText = FORMAT ( [% of Total], "0.0%" )
				RETURN
				    IF(ISINSCOPE(Identity[Identity Type]) || ISINSCOPE(Resource[Resource Type]) || ISINSCOPE(Workspace[Workspace Name]), FormatCurrencyValue ( SELECTEDMEASURE (), 1 ) & " " & _Q & "(" & _PctText & " of total)" & _Q, FormatCurrencyValue ( SELECTEDMEASURE (), 1 ))

	measure 'Measure 2' =
			VAR _numerator =
			    IF (
			        SELECTEDVALUE ( 'CostOrUsage'[Short Name] ) = "Cost",
			        [Total Cost (USD)],
			        [Total Usage (DBUs)]
			    )
			VAR _denominator =
			    IF (
			        SELECTEDVALUE ( 'CostOrUsage'[Short Name] ) = "Cost",
			        CALCULATE ( [Total Cost (USD)]),
			        CALCULATE ( [Total Usage (DBUs)])
			    )
			RETURN
			    DIVIDE ( _numerator, _denominator )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Cost\Rankings
		lineageTag: 857ed9a2-4f0b-4a90-9d1e-6de44773e5d5

	measure 'Measure 3' = SELECTEDVALUE ( 'CostOrUsage'[Short Name] )
		displayFolder: Cost\Rankings
		lineageTag: 2dbc86fd-3e27-4543-830c-67bb45885762

	/// Total usage quantity across all SKUs and usage types.
	measure 'Total Usage (DBUs) Formatted' = [Total Usage (DBUs)]
		displayFolder: Volume
		lineageTag: 94169d4d-5b51-4c4d-b684-f631371b07fe

		formatStringDefinition = ```
				VAR _Q = UNICHAR ( 34 )
				VAR _PctText = FORMAT ( [% of Total], "0.0%" )
				RETURN
				    IF(ISINSCOPE(Identity[Identity Type]) || ISINSCOPE(Resource[Resource Type]) || ISINSCOPE(Workspace[Workspace Name]), FormatValue ( SELECTEDMEASURE () ) & " " & _Q & "(" & _PctText & " of total)" & _Q, FormatValue ( SELECTEDMEASURE ()))
				
				```

	/// Placeholder text column on the measures-only KPIs table; not intended for use in visuals.
	column KPIs
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: eec1a844-d891-4d50-b62a-86b0099714e6
		summarizeBy: none
		sourceColumn: KPIs

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition KPIs = m
		mode: import
		source =
				let
				    Source = ""
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

