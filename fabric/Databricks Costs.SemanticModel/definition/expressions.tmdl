expression fn_Calendar =
		let CreateDateTable = (P_StartDate as date,P_EndDate as date) as table =>
		    let
		        NumberOfDays = Duration.Days(Duration.From(P_EndDate-P_StartDate)) + 1,
		        Source = List.Dates(P_StartDate,NumberOfDays,#duration(1,0,0,0)),
		        TableFromList = Table.FromList(Source,Splitter.SplitByNothing(),{"Date"}),
		        ChangeType = Table.TransformColumnTypes(TableFromList,{{"Date", type date}}),
		        // Year
		        AddYear = Table.AddColumn(ChangeType,"Year",each Date.Year([Date]),Int64.Type),
		        // Quarter
		        AddQuarterNum = Table.AddColumn(AddYear,"Quarter Number",each Date.QuarterOfYear([Date]),Int64.Type),
		        AddQuarterSortKey = Table.AddColumn(AddQuarterNum,"Quarter Sort Key",each Date.Year([Date]) * 10 + Date.QuarterOfYear([Date]),Int64.Type),
		        AddQuarterOfYear = Table.AddColumn(AddQuarterSortKey,"Quarter of Year",each "Q" & Text.From(Date.QuarterOfYear([Date])),type text),
		        AddQuarter = Table.AddColumn(AddQuarterOfYear,"Quarter",each "Q" & Text.From(Date.QuarterOfYear([Date])) & "." & Text.From(Date.Year([Date])),type text),
		        // Month
		        AddMonthOfYearNum = Table.AddColumn(AddQuarter,"Month of Year Number",each Date.Month([Date]),Int64.Type),
		        AddMonthSortKey = Table.AddColumn(AddMonthOfYearNum,"Month Sort Key",each Date.Year([Date]) * 100 + Date.Month([Date]),Int64.Type),
		        AddMonthOfYear = Table.AddColumn(AddMonthSortKey,"Month of Year",each Date.MonthName([Date],"en-US"),type text),
		        AddMonth = Table.AddColumn(AddMonthOfYear,"Month",each Date.ToText([Date],"MMMM yyyy","en-US"),type text),
		        AddMonthOfQuarterNum = Table.AddColumn(AddMonth,"Month of Quarter Number",each Date.Month([Date]) - (Date.QuarterOfYear([Date]) - 1) * 3,Int64.Type),
		        AddMonthOfQuarter = Table.AddColumn(AddMonthOfQuarterNum,"Month of Quarter",each "QM" & Text.From(Date.Month([Date]) - (Date.QuarterOfYear([Date]) - 1) * 3),type text),
		        // Week
		        AddWeekOfYearNum = Table.AddColumn(AddMonthOfQuarter,"Week of Year Number",each Date.WeekOfYear([Date],Day.Monday),Int64.Type),
		        AddWeekSortKey = Table.AddColumn(AddWeekOfYearNum,"Week Sort Key",each Date.Year([Date]) * 100 + Date.WeekOfYear([Date],Day.Monday),Int64.Type),
		        AddWeekOfYear = Table.AddColumn(AddWeekSortKey,"Week of Year",each "W" & Text.PadStart(Text.From(Date.WeekOfYear([Date],Day.Monday)),2,"0"),type text),
		        AddWeek = Table.AddColumn(AddWeekOfYear,"Week",each Text.From(Date.Year([Date])) & "-W" & Text.PadStart(Text.From(Date.WeekOfYear([Date],Day.Monday)),2,"0"),type text),
		        AddWeekOfQuarterNum = Table.AddColumn(AddWeek,"Week of Quarter Number",each Date.WeekOfYear([Date],Day.Monday) - Date.WeekOfYear(Date.StartOfQuarter([Date]),Day.Monday) + 1,Int64.Type),
		        AddWeekOfQuarter = Table.AddColumn(AddWeekOfQuarterNum,"Week of Quarter",each "QW" & Text.From(Date.WeekOfYear([Date],Day.Monday) - Date.WeekOfYear(Date.StartOfQuarter([Date]),Day.Monday) + 1),type text),
		        AddWeekOfMonthNum = Table.AddColumn(AddWeekOfQuarter,"Week of Month Number",each Date.WeekOfMonth([Date],Day.Monday),Int64.Type),
		        AddWeekOfMonth = Table.AddColumn(AddWeekOfMonthNum,"Week of Month",each "MW" & Text.From(Date.WeekOfMonth([Date],Day.Monday)),type text),
		        // Day
		        AddDayOfYear = Table.AddColumn(AddWeekOfMonth,"Day of Year",each Date.DayOfYear([Date]),Int64.Type),
		        AddDayOfQuarter = Table.AddColumn(AddDayOfYear,"Day of Quarter",each Duration.Days([Date] - Date.StartOfQuarter([Date])) + 1,Int64.Type),
		        AddDayOfMonth = Table.AddColumn(AddDayOfQuarter,"Day of Month",each Date.Day([Date]),Int64.Type),
		        AddDayOfWeek = Table.AddColumn(AddDayOfMonth,"Day of Week",each Date.DayOfWeek([Date],Day.Monday) + 1,Int64.Type),
		        AddDayOfWeekName = Table.AddColumn(AddDayOfWeek,"Day of Week Name",each Date.ToText([Date],"dddd","en-US"),type text)
		    in
		        AddDayOfWeekName
		in
		    CreateDateTable
	lineageTag: dc915ec4-345c-4e27-8e12-b2f5f2632ca3

