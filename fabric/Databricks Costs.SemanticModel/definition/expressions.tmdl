/// Derives the start and end dates from the Costs usage_dt column to drive the Calendar table range.
expression _DatesPoints =
		let
		    Source = _Catalog,
		    vf_pbi_billing_cost_View = Source{[Name="vf_pbi_billing_cost",Kind="View"]}[Data],
		    #"Removed Other Columns" = Table.SelectColumns(vf_pbi_billing_cost_View,{"usage_dt"}),
		    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns"),
		    #"Changed Type" = Table.TransformColumnTypes(#"Removed Duplicates",{{"usage_dt", type date}}),
		    #"Grouped Rows" = Table.Group(#"Changed Type", {}, {{"StartDate", each List.Min([usage_dt]), type nullable date}, {"EndDate", each List.Max([usage_dt]), type nullable date}}),
		    #"Calculated Start of Month" = Table.TransformColumns(#"Grouped Rows",{{"StartDate", Date.StartOfMonth, type date}}),
		    #"Calculated End of Month" = Table.TransformColumns(#"Calculated Start of Month",{{"EndDate", Date.EndOfMonth, type date}})
		in
		    #"Calculated End of Month"
